<Project>
  <PropertyGroup>
    <DebuggerTargetFramework>net10.0</DebuggerTargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.3.0</Version>
    <Authors>DncDbg contributors</Authors>
    <Product>DNCDbg</Product>
    <RepositoryUrl>https://github.com/mattleibow/dncdbg</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/mattleibow/dncdbg</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(DncDbgTestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);DNCDBG_REMOTE_TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <Target Name="RejectLegacyRemoteGates" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EnableExperimentalRemoteDebugging)' != '' Or '$(EnableExperimentalPrivateBootstrap)' != '' Or '$(EnableExperimentalTestFaults)' != '' Or '$(EnableExperimentalRemoteTestHooks)' != ''"
           Text="Legacy remote opt-in properties were removed. Remote debugging is enabled by its target package/configuration. Test hooks are internal DncDbgTestHooks/DncDbgTestFaults only." />
  </Target>
</Project>
